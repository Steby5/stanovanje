# trigger words then stay on your machine instead of in the repo.
groups.txt
keywords.txt
keywords/

# --- local tooling ------------------------------------------------------
.claude/settings.local.json
.vscode/
.idea/

# --- python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# A session export is a live Facebook login - never commit it.
session.json
*.session.json
